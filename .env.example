# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and customize for local or production use.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# Security & Debugging
# Set DEBUG to False in staging and production environments
DEBUG=False
SECRET_KEY=replace-with-secure-64-char-random-key

# Host & Origin Security (comma-separated lists)
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database Engine Configuration
# Supported schemes: postgres://, postgresql://, sqlite:///
# Example PostgreSQL: postgres://postgres:postgres@localhost:5432/culer_db
# If empty or not set, settings fallback to local sqlite:///db.sqlite3
DATABASE_URL=postgres://postgres:postgres@localhost:5432/culer_db

# External API Integrations (Optional / Features)
FOOTBALL_DATA_API_KEY=
OPENROUTER_API_KEY=

